# Postgres: in production use Supabase transaction pooler URL (port 6543)
DATABASE_URL=
# Supabase prod-ca-2021.crt contents; required on Vercel to verify the pooler TLS certificate
DATABASE_SSL_CA=
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Storage S3 credentials (server-only; keep bucket public for public media URLs)
S3_BUCKET=media
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Local dev only: `npm run seed` creates this admin user
SEED_ADMIN_EMAIL=admin@aum.test
SEED_ADMIN_PASSWORD=

# AI pipeline: writing uses OpenAI; relevance scoring uses DeepSeek.
SITE_URL=http://localhost:3000
AI_BOT_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://models.jarvislabs.net/v1
# OpenAI model ID selected from the current official model/pricing docs: https://platform.openai.com/pricing/
WRITER_MODEL=gpt-4.1-mini
SCORER_MODEL=deepseek-v4.1-flash-1017
EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens. Update from official pricing pages before changing model IDs.
PRICE_OPENAI_INPUT=0.4
PRICE_OPENAI_OUTPUT=1.6
PRICE_OPENAI_EMBEDDING=0.02
PRICE_DEEPSEEK_INPUT=0.3
PRICE_DEEPSEEK_OUTPUT=1.2
MAX_ITEMS_PER_DAY=8
DRY_RUN=0
PREVIEW_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ALLOW_SEED=false

# Blog platform (docs/07-blog-platform.md)
CRON_SECRET=
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Agency OS attribution tracker (default http://localhost:3010 in dev; set Cloudflare Tunnel / live URL in Vercel)
NEXT_PUBLIC_AGENCY_TRACKER_ORIGIN=http://localhost:3010
