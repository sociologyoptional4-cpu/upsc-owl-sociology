{
  "name": "aum",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:production": "npm run payload -- migrate && npm run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "pipeline:daily": "tsx src/pipeline/run-daily.ts",
    "pipeline:dry": "DRY_RUN=1 tsx src/pipeline/run-daily.ts",
    "pipeline:eval": "tsx src/pipeline/eval-run.ts",
    "pipeline:quiz": "tsx src/pipeline/quiz-daily.ts",
    "pipeline:digest": "tsx src/pipeline/digest.ts",
    "notes:daily": "tsx src/pipeline/notes/run-notes.ts",
    "notes:dry": "DRY_RUN=1 tsx src/pipeline/notes/run-notes.ts",
    "syllabus:build": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/notes/build-syllabus.ts",
    "pyq:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/pyq/import.ts",
    "test:unit": "vitest run --config ./vitest.config.mts tests/unit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/storage-s3": "^3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "mammoth": "^1.13.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "openai": "^7.62.0",
    "payload": "3.94.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
